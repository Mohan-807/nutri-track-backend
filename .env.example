DATABASE_URL=postgresql+psycopg://nutri:password@localhost:5432/nutri_tracker
SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
# Failover order, highest priority first. A provider with no API key is skipped automatically,
# so you only need to configure the ones you actually have keys for. If every configured provider
# is unavailable, the chat replies "All AI models are currently unavailable".
LLM_PROVIDER_ORDER=gemini,nvidia

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30

# NVIDIA NIM (OpenAI-compatible) — https://build.nvidia.com/
NVIDIA_API_KEY=your-nvidia-nim-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_TIMEOUT_SECONDS=120
NVIDIA_MAX_TOKENS=8192
